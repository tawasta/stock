<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='outgoing_delivery_address']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>

        <xpath expr="//t[@t-set='partner']" position="after">
            <div class="col-6 mb-3" style="float: left; padding-left: 1em;">
                <div t-if="o.sudo().sale_id">
                    <span><strong>Ordered By:</strong></span>
                    <div
                        t-out="o.sudo().sale_id.partner_id"
                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
                        class="mb-2"
                    >
                    </div>
                </div>
            </div>

            <div
                class="col-6 mb-3"
                name="div_outgoing_address_delivery"
                style="float: left; padding-left: 1em;"
            >
                <div
                    name="outgoing_delivery_address"
                    t-if="o.should_print_delivery_address()"
                >
                    <span><strong>Delivery Address:</strong></span>
                    <div
                        t-out="o.move_ids[0].partner_id or o.partner_id"
                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
                    />
                </div>
            </div>
        </xpath>
    </template>
</odoo>
