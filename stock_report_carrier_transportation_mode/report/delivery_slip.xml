<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_delivery_document"
        inherit_id="stock_report_element_sizes.report_delivery_document"
    >
        <div id='stock_deliveryslip_informations' position="inside">
            <div
                t-if="o.carrier_id.name and 'carrier_id' in o.fields_get()"
                class="col-auto mw-100 mb-2"
            >
                <strong>MODE OF TRANSPORTATION:</strong>
                <p class="m-0" t-field="o.carrier_id.name" />
            </div>
        </div>
    </template>
</odoo>
