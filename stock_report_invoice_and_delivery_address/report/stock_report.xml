<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_delivery_document"
        inherit_id="stock.report_delivery_document"
        priority="100"
    >
        <xpath expr="//t[@t-set='partner']" position="after">
            <div class="col-6 mb-3" style="float: left; padding-left: 1em;">
                <div name="invoice_address">
                    <span><strong>INVOICE ADDRESS:</strong></span>
                    <t t-if="o.sudo().sale_id.partner_invoice_id">
                        <div
                            t-field="o.sudo().sale_id.partner_invoice_id"
                            t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"
                        />
                    </t>
                </div>
            </div>

            <div
                class="col-6 mb-3"
                name="div_outgoing_address_delivery"
                style="float: left; padding-left: 1em;"
            >
                <div
                    name="outgoing_delivery_address_delivery"
                    t-if="o.should_print_delivery_address()"
                >
                    <span><strong>DELIVERY ADDRESS:</strong></span>
                    <div
                        t-out="o.move_ids[0].partner_id or o.partner_id"
                        t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"
                    />
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@name='div_outgoing_address']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//div[@name='div_incoming_address']/../.." position="attributes">
            <attribute
                name="t-if"
            >o.picking_type_id.code=='incoming' and partner</attribute>
        </xpath>
    </template>
</odoo>
