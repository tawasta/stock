<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
		<field name="name">stock.picking.form.inherit.show.move.source.location</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form" />
		<field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']//tree//field[@name='location_id']"
                position="attributes"
            >
                <attribute
                    name="column_invisible"
                >parent.picking_type_code == 'incoming'</attribute>
                <attribute name="optional">show</attribute>
		    </xpath>
		</field>
	</record>
</odoo>
