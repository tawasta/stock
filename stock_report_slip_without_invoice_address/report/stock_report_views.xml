<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_report_delivery_without_invoice_address" model="ir.actions.report">
    <field name="name">Delivery slip with delivery address only</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >stock_report_slip_without_invoice_address.deliveryslip_without_invoice_addr</field>
    <field
      name="report_file"
    >stock_report_slip_without_invoice_address.deliveryslip_without_invoice_addr</field>
    <field
      name="print_report_name"
    >'Delivery Slip with Delivery address- %s - %s' % (object.partner_id.name or '', object.name)</field>
    <field name="binding_model_id" ref="stock.model_stock_picking" />
    <field name="binding_type">report</field>
  </record>
</odoo>
