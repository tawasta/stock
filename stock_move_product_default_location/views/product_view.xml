<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_template_property_form" model="ir.ui.view">
		<field name="name">product.template.stock.default.location</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="stock.view_template_property_form" />
		<field name="arch" type="xml">
            <xpath
                expr="//group[@name='stock_property']//field[@name='property_stock_inventory']"
                position="after"
            >
                <field name="default_stock_move_location_id" />
		    </xpath>
		</field>
	</record>
</odoo>
