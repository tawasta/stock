<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.view.form.report.delivery.slip.barcodes</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//setting[@id='warning_info']" position="after">
        <setting
          id="delivery_slip_product_barcodes"
          string="Delivery Slip Product Barcodes"
          help="Display product barcodes on delivery slips"
        >
          <field name="delivery_slip_product_barcodes" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
