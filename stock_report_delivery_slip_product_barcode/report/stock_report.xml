<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
    <!-- Read the setting once; the t-called line templates inherit the variable.
         sudo: stock users have no read access to ir.config_parameter. -->
    <xpath expr="//div[hasclass('page')]" position="before">
      <t
        t-set="barcode_as_image"
        t-value="env['ir.config_parameter'].sudo().get_param('stock_report_delivery_slip_product_barcodes.delivery_slip_product_barcodes') == 'True'"
      />
    </xpath>

    <!-- State != Done, heading and lines -->
    <xpath
      expr="//table[@name='stock_move_table']/thead//th[@name='th_sm_product']"
      position="before"
    >
      <th name="th_sm_barcode" class="text-center">
        <strong>EAN</strong>
      </th>
    </xpath>

    <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="before">
      <td name="td_sm_barcode" class="text-center">
        <span
          t-if="barcode_as_image"
          t-field="move.product_id.barcode"
          t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 200, 'height': 46, 'humanreadable': 1}"
        />
        <span t-else="" t-field="move.product_id.barcode" />
      </td>
    </xpath>

    <!-- State == Done, heading -->
    <xpath
      expr="//table[@name='stock_move_line_table']/thead//th[@name='th_sml_product']"
      position="before"
    >
      <th name="th_sml_barcode" class="text-center">
        <strong>EAN</strong>
      </th>
    </xpath>
  </template>

  <!-- State == Done, lines without printed lot/serial numbers -->
  <template
    id="stock_report_delivery_aggregated_move_lines"
    inherit_id="stock.stock_report_delivery_aggregated_move_lines"
  >
    <xpath expr='//tr[@t-as="line"]/td[1]' position="before">
      <td name="td_sm_barcode" class="text-center">
        <span
          t-if="barcode_as_image"
          t-out="aggregated_lines[line]['barcode']"
          t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 200, 'height': 46, 'humanreadable': 1}"
        />
        <span t-else="" t-out="aggregated_lines[line]['barcode']" />
      </td>
    </xpath>
  </template>

  <!-- State == Done, lines with printed lot/serial numbers -->
  <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
  >
    <xpath expr="//span[@t-field='move_line.product_id']/.." position="before">
      <td name="td_sml_barcode" class="text-center">
        <span
          t-if="barcode_as_image"
          t-field="move_line.product_id.barcode"
          t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 200, 'height': 46, 'humanreadable': 1}"
        />
        <span t-else="" t-field="move_line.product_id.barcode" />
      </td>
    </xpath>
  </template>
</odoo>
