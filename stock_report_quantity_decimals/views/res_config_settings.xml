<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.view.form.report.decimal.precision</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <setting id="warning_info" position="after">
        <setting
          id="stock_report_decimal_precision"
          string="Stock Report Decimal Precision"
          help="Set Decimal Precision on stock report's product quantities"
        >
          <field name="stock_report_decimal_precision" options="{'no_create': True}" />
        </setting>
      </setting>
    </field>
  </record>
</odoo>
