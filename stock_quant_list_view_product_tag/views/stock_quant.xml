<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.tree.product.tags</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="product_tag_ids" optional="show" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.product.tags</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="product_tag_ids" optional="show" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="quant_search_view" model="ir.ui.view">
        <field name="name">stock.quant.search.product.tags</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <field name="lot_properties" position="after">
                <field name="product_tag_ids" />
            </field>
        </field>
    </record>
</odoo>
