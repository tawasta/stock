<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_custom_labels" model="ir.ui.view">
        <field name="name">stock.picking.form.custom.labels</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <button name="action_open_label_type" position="after">
                <button
                    name="action_print_custom_labels"
                    string="Custom Labels"
                    type="object"
                    invisible="picking_type_code == 'outgoing'"
                />
            </button>
        </field>
    </record>
</odoo>
