<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.location.warning</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="has_custom_line_locations" invisible="1" />
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not has_custom_line_locations or state in ['done', 'cancel']"
                >
                    <i class="fa fa-exclamation-triangle me-2" />
                    Some Operations have custom source or destination locations set.
                    Changing the top-level Source Location or Destination Location
                    will overwrite those per-line values.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
