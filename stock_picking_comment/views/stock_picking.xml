<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.comment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="note" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <page name="note" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>

            <page name="operations" position="inside">
                <group string="Note (internal, for Picking Operations sheet)">
                    <field
                        name="note"
                        placeholder="Add an internal note for operations."
                    />
                </group>
                <group string="Comment (printed on the Delivery Slip)">
                    <field
                        name="comment"
                        placeholder="Add a comment for the delivery slip."
                    />
                </group>
            </page>

        </field>
    </record>

</odoo>
