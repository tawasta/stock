<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.create.production.order</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']//tree//field[@name='product_uom']"
                position="after"
            >
                <button
                    name="create_and_validate_manufacturing_order"
                    type="object"
                    string="Produce product"
                    class="oe_highlight"
                    invisible="not has_bom or state in ('draft', 'cancel', 'assigned', 'done') or mo_has_been_created"
                />
                <field name="has_bom" column_invisible="True" />
                <field name="mo_has_been_created" column_invisible="True" />
                <field name="manufacturing_order_id" />
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="name">stock.move.form.manufacturing.order.info</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations" />
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <group name="manufacturing_order">
                    <group string="Manufacturing Order">
                        <field name="manufacturing_order_id" />
                        <field name="mo_state" />
                    </group>
                </group>
            </field>
        </field>
    </record>
</odoo>
