<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
		<field name="name">stock.quant.inventory.tree.relocate.move_to</field>
		<field name="model">stock.quant</field>
		<field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="priority" eval="100" />
		<field name="arch" type="xml">
            <xpath expr="//header//button[last()]" position="after">
                <button
                    name="%(stock_move_location.wiz_stock_quant_location_action)d"
                    groups="stock.group_stock_manager"
                    string="Relocate"
                    type="action"
                />
		    </xpath>

            <xpath
                expr="//button[@name='action_stock_quant_relocate']"
                position="replace"
            />
		</field>
	</record>

    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
		<field name="name">stock.quant.tree.relocate.move_to</field>
		<field name="model">stock.quant</field>
		<field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="priority" eval="100" />
		<field name="arch" type="xml">
            <xpath expr="//header//button[last()]" position="after">
                <button
                    name="%(stock_move_location.wiz_stock_quant_location_action)d"
                    groups="stock.group_stock_manager"
                    string="Relocate"
                    type="action"
                />
		    </xpath>

            <xpath
                expr="//button[@name='action_stock_quant_relocate']"
                position="replace"
            />
		</field>
	</record>
</odoo>
