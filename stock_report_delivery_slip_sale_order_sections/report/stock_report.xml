<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@name='aggregated_move_lines']" position="attributes">
            <attribute name="t-else" />
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@name='aggregated_move_lines']" position="after">
            <t t-if="not has_serial_number" name="aggregated_move_lines_sectioned">
                <t
                    t-foreach="o._get_delivery_slip_line_groups(o.move_line_ids)"
                    t-as="delivery_group"
                >
                    <t t-foreach="delivery_group[0]" t-as="header_line">
                        <tr
                            t-att-class="'bg-200 fw-bold o_line_section' if header_line.display_type == 'line_section' else 'fst-italic o_line_note'"
                        >
                            <td colspan="99">
                                <span t-field="header_line.name" />
                            </td>
                        </tr>
                    </t>
                    <t t-set="aggregated_lines" t-value="delivery_group[1]" />
                    <t t-call="stock.stock_report_delivery_aggregated_move_lines" />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
