#. module: stock_report_delivery_slip_c5_letter_friendly_positioning
#: model_terms:ir.ui.view,arch_db:stock_report_delivery_slip_c5_letter_friendly_positioning.res_config_settings_view_form
msgid ""
"Adjust as needed to get the print's address to align with the C5 letter's "
"window."
msgstr ""
"Säädä tarvittaessa, jotta tulosteen osoite osuu C5-kirjekuoren ikkunaan."

#. module: stock_report_delivery_slip_c5_letter_friendly_positioning
#: model:ir.model.fields,help:stock_report_delivery_slip_c5_letter_friendly_positioning.field_res_config_settings__stock_report_delivery_slip_c5_vertical_offset
msgid ""
"Adjust as needed to get the print's address to align with the C5 letter's "
"window. Positive values move the address down, negative values up."
msgstr ""
"Säädä tarvittaessa, jotta tulosteen osoite osuu C5-kirjekuoren ikkunaan. "
"Positiiviset arvot siirtävät osoitetta alaspäin, negatiiviset ylöspäin."

#. module: stock_report_delivery_slip_c5_letter_friendly_positioning
#: model:ir.model.fields,help:stock_report_delivery_slip_c5_letter_friendly_positioning.field_res_config_settings__stock_report_delivery_slip_c5_horizontal_offset
msgid ""
"Adjust as needed to get the print's address to align with the C5 letter's "
"window. Positive values move the address right, negative values left."
msgstr ""
"Säädä tarvittaessa, jotta tulosteen osoite osuu C5-kirjekuoren ikkunaan. "
"Positiiviset arvot siirtävät osoitetta oikealle, negatiiviset vasemmalle."

