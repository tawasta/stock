<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field
      name="name"
    >res.config.settings.view.form.delivery.slip.c5.letter.friendly.positioning</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//block[@name='shipping_setting_container']" position="inside">
        <setting
          id="stock_report_delivery_slip_c5_offset"
          string="Delivery Slip: C5 Letter Address Offset"
          help="Adjust as needed to get the print's address to align with the C5 letter's window."
        >
          <div class="content-group">
            <div class="row mt16">
              <label
                for="stock_report_delivery_slip_c5_vertical_offset"
                string="Vertical (mm)"
                class="col-lg-4 o_light_label"
              />
              <field name="stock_report_delivery_slip_c5_vertical_offset" />
            </div>
            <div class="row">
              <label
                for="stock_report_delivery_slip_c5_horizontal_offset"
                string="Horizontal (mm)"
                class="col-lg-4 o_light_label"
              />
              <field name="stock_report_delivery_slip_c5_horizontal_offset" />
            </div>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
