<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_check_orderpoint_alert_qty" model="ir.cron">
        <field name="name">Check Replenishment alert quantity</field>
        <field name="model_id" ref="model_stock_warehouse_orderpoint" />
        <field name="state">code</field>
        <field name="code">model.cron_qty_on_hand_alert()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="1" />
        <field name="interval_type">hours</field>
        <field name="numbercall" eval="-1" />
        <field name="priority" eval="5" />
        <field name="doall" eval="0" />
        <field name="active" eval="0" />
    </record>
</odoo>
