<odoo>


    <record id="view_stock_move_line_inventory_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock_inventory.view_stock_move_line_inventory_tree"
        />
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field name="inventory_theoretical_qty" optional="show" />
                <field name="inventory_real_qty" optional="show" />
            </field>
        </field>
    </record>

</odoo>
