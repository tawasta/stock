<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <!-- binding_model_id makes this appear directly in the "Print" menu on
         a stock.lot record, the same way core's own "Lot/Serial Number
         (PDF)"/"(ZPL)" actions do (stock.action_report_lot_label /
         stock.label_lot_template) -->
  <record id="label_zd620_lot" model="ir.actions.report">
    <field name="name">Lot/Serial Number (ZD620)</field>
    <field name="model">stock.lot</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">stock_label_zebra_zd620.label_zd620_lot_view</field>
    <field name="report_file">stock_label_zebra_zd620.label_zd620_lot_view</field>
    <field
      name="paperformat_id"
      ref="stock_label_zebra_zd620.paperformat_zd620_label"
    />
    <field name="print_report_name">'Lot-Serial - %s' % object.name</field>
    <field name="binding_model_id" ref="stock.model_stock_lot" />
    <field name="binding_type">report</field>
  </record>

  <template id="label_zd620_lot_view">
    <t t-call="web.html_container">
      <style>
                html, body { margin: 0; padding: 0; background-color: #FFFFFF; }
            </style>
      <t t-foreach="docs" t-as="lot">
        <div
          class="page"
          style="width:76mm;height:50mm;margin:0;padding:2mm;box-sizing:border-box;overflow:hidden;background-color:#FFFFFF;color:#000000;font-family:Arial,Helvetica,sans-serif;display:flex;flex-direction:column;"
        >
          <div
            style="font-size:11px;font-weight:bold;border-bottom:0.3mm solid #000000;padding-bottom:0.5mm;"
          >
            <span t-out="company.name" />
          </div>
          <div style="font-size:13px;margin-top:1mm;">
                        LOT: <span t-field="lot.name" style="font-weight:bold;" />
                    </div>
          <div
            style="font-size:28px;font-weight:bold;line-height:1.05;margin-top:1mm;text-align:center;"
          >
            <span t-field="lot.product_qty" />
            <span t-field="lot.product_uom_id.name" style="font-size:16px;" />
          </div>
          <div
            style="font-size:16px;line-height:1.2;overflow:hidden;margin-top:1mm;text-align:center;flex-grow:1;"
          >
            <span t-field="lot.product_id.display_name" />
          </div>
          <div t-if="lot.product_id.barcode" style="text-align:center;margin-top:1mm;">
            <img
              t-att-src="env['ir.actions.report'].zd620_barcode_data_uri(lot.product_id.barcode)"
              style="width:50mm;height:7mm;"
            />
          </div>
        </div>
      </t>
    </t>
  </template>
</odoo>
