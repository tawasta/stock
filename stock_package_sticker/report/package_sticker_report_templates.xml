<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="stock_package_sticker.report_package_sticker">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="stock_package_sticker.package_sticker_document"
                    t-lang="doc.partner_id.lang"
                />
            </t>
        </t>
    </template>


    <template id="stock_package_sticker.package_sticker_document">
        <t t-call="web.external_layout">

            <t t-set="doc" t-value="doc.with_context(lang=lang)" />

            <div class="">
                <div class="row" style="margin-bottom: 2em;">
                    <!-- Company logo -->
                    <div class="col-6" style="margin-bottom: 2em; margin-top: 8em;">
                        <img
                            t-if="doc.company_id.logo"
                            t-att-src="image_data_uri(doc.company_id.logo)"
                            style="max-height: 120px"
                            alt="Logo"
                        />
                    </div>

                    <!-- Area for writing by hand -->
                    <div class="col-6" id="containers-area" style=" margin-top: 8em;">


                        <div
                            style="width: 120px; height: 120px; border: 1px solid black; float: left;"
                        />
                        <div
                            style="width: 120px; height: 120px; border: 1px solid black; float: left;"
                        >
                            <div
                                id="container-header"
                                style="width: 100px; margin-left: -50px; background: #eee; border: 1px solid #333; text-align: center;"
                            >Containers</div>
                        </div>


                    </div>
                </div>
            </div>


            <div style="display: block;">
                <div>
                    <h2>
                        <strong>Customer:</strong>
                    </h2>
                    <div
                        id="customer-address-area"
                        style="margin-bottom: 25px; font-size: 140%;"
                        t-esc="doc.partner_id"
                        t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': true}"
                    />
                </div>

                <div class="">
                    <t t-if="doc.header_text">
                        <h2>
                            <strong>Dispatch Note Header:</strong>
                        </h2>
                    </t>
                </div>

                <div class="row">
                    <t t-if="doc.header_text">
                        <h3>
                            <div
                                t-field="doc.header_text"
                                id="origin-area"
                                style="margin-bottom: 55px; font-size: 140%;"
                            />
                        </h3>
                    </t>
                </div>

                <div class="row">
                    <t t-if="doc.origin">
                        <h2>
                            <strong>Order number / Markings:</strong>
                        </h2>
                    </t>
                </div>

                <div class="row">
                    <t t-if="doc.origin">
                        <h3>
                            <div
                                t-field="doc.origin"
                                id="origin-area"
                                style="margin-bottom: 25px; font-size: 140%;"
                            />
                        </h3>
                    </t>
                </div>
            </div>

        </t>
    </template>
</odoo>
