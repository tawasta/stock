<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_set_or_create_putaway_default" model="ir.cron">
        <field name="name">Set or Create Putaway with default Product location</field>
        <field name="model_id" ref="model_product_template" />
        <field name="state">code</field>
        <field name="code">model.cron_product_default_location_putaway()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1" />
        <field name="priority" eval="5" />
        <field name="doall" eval="0" />
        <field name="active" eval="0" />
    </record>
</odoo>
