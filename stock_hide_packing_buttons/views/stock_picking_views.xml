<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_hide_packing_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.hide.packing.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_put_in_pack']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="custom_hide_put_in_pack_button" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.hide.put.in.pack</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//header/button[@name='action_put_in_pack']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
