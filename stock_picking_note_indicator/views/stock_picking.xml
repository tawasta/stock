<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_note_indicator" model="ir.ui.view">
        <field name="name">stock.picking.form.note.indicator</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='company_id'][@invisible='1']" position="after">
                <field name="has_note_text" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='picking_properties']" position="after">
                <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 mb-0"
                     role="alert"
                     invisible="not has_note_text">
                    <i class="fa fa-exclamation-triangle" role="img" aria-label="Warning"/>
                    <div>
                        <strong>Internal note added.</strong>
                        Please review the Note tab before validating or processing this transfer.
                    </div>
                </div>
            </xpath>

            <xpath expr="//page[@name='note']" position="attributes">
                <attribute name="string">Note</attribute>
            </xpath>

        </field>
    </record>
</odoo>