<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <!-- Report: single ean code -->
        <template id="report_simple_label_ean_as_barcode">
            <div class="o_label_sheet o_label_ean_as_barcode">
                <div class="o_label_full">
                    <div class="text-center o_label_ean_as_barcode_product_name_area">
                       <span
                        t-field="product.with_context(display_default_code=True).display_name"
                    />
                    </div>

                    <div
                    class="text-center o_label_small_barcode o_label_ean_as_barcode_barcode_area"
                >
                        <t t-if="ean_code">
                            <div
                            t-out="ean_code"
                            style="padding-top: 10px"
                            t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'Code128', 'img_style': barcode_size}"
                        />
                            <div>
                                <span t-out="ean_code" />
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </template>

        <!-- Report: ean code loop -->
        <template id="report_productlabel_ean_as_barcode">
            <t t-call="web.html_container">
                <t t-set="barcode_size" t-value="'width:50mm;height:12mm'" />
                <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                    <t t-set="product" t-value="barcode_and_qty_by_product[0]" />
                    <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                        <t t-set="ean_code" t-value="barcode_and_qty[0]" />
                        <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                            <!-- TODO: currently always called in english. Make configurable if necessary -->
                            <t
                            t-call="stock_report_label_product_ean_code.report_simple_label_ean_as_barcode"
                            t-lang="en_US"
                        />
                        </t>
                    </t>
                </t>
            </t>
        </template>

        <!-- Report: main entry point-->
        <template id="ean_as_barcode">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t
                    t-call="stock_report_label_product_ean_code.report_productlabel_ean_as_barcode"
                />
                </div>
            </t>
        </template>

        <!-- Paperformat-->
        <record
        id="paperformat_product_template_label_ean_as_barcode"
        model="report.paperformat"
    >
            <field name="name">Paperformat for: Product Label - EAN as Barcode</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">76</field>
            <field name="page_width">51</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True" />
            <field name="dpi">96</field>
        </record>

        <!-- Report action -->
        <record
        id="report_product_product_label_ean_as_barcode"
        model="ir.actions.report"
    >
            <field name="name">Product Label - EAN as Barcode</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field
            name="report_name"
        >stock_report_label_product_ean_code.ean_as_barcode</field>
            <field
            name="report_file"
        >stock_report_label_product_ean_code.ean_as_barcode</field>
            <field
            name="paperformat_id"
            ref="stock_report_label_product_ean_code.paperformat_product_template_label_ean_as_barcode"
        />
            <field
            name="print_report_name"
        >'Products Labels - %s' % (object.name)</field>
            <field name="binding_type">report</field>
        </record>

</odoo>
