<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_quant_barcode_update_wizard_form" model="ir.ui.view">
        <field name="name">quant.barcode.update.wizard.form</field>
        <field name="model">quant.barcode.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Update by Barcode" class="o_form_view">
                <sheet>
                            <field name="barcode" placeholder="Scan GS1 Barcode..." />
                            <field
                        name="info_message"
                        readonly="1"
                        nolabel="1"
                        class="text-danger fw-bold"
                        invisible="not info_message"
                    />

                        <field name="scanned_barcodes" nolabel="1">
                            <tree>
                                <field name="barcode" />
                                <field name="ai_01" />
                                <field name="ai_10" />
                                <field name="ai_17" />
                            </tree>
                        </field>


                    <separator string="Scanned Items" />

                    <field name="scanned_line_ids">
                        <tree editable="bottom">
                            <field name="product_id" />
                            <field name="lot_id" />
                            <field name="expiration_date" />
                            <field name="quantity" />
                        </tree>
                    </field>

                    <footer>
                        <button
                            name="action_apply"
                            type="object"
                            string="Apply Inventory Update"
                            class="btn-primary"
                        />
                        <button string="Close" special="cancel" class="btn-secondary" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quant_barcode_update_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Barcode Wizard</field>
        <field name="res_model">quant.barcode.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_quant_barcode_update_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_quant_barcode_update_root"
        name="Inventory Update"
        parent="stock.menu_stock_root"
        action="action_quant_barcode_update_wizard"
        sequence="10"
    />
</odoo>
