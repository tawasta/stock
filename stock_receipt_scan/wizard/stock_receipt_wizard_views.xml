<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_receipt_wizard_form" model="ir.ui.view">
        <field name="name">stock.receipt.wizard.form</field>
        <field name="model">stock.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Stock Receipt">
                <group>
                    <field name="barcode_input" placeholder="Scan or enter barcode"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="barcode"/>
                        <field name="quantity"/>
                        <field name="stock_move_id"/>
                    </tree>
                </field>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
