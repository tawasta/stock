<?xml version="1.0" encoding="UTF-8" ?>
<!-- DEPRECATED. PLEASE USE stock_barcode_transfer_wizard -->
<odoo>
    <record id="view_stock_receipt_wizard_form" model="ir.ui.view">
        <field name="name">stock.receipt.wizard.form</field>
        <field name="model">stock.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Stock Receipt" version="7.0">
                <sheet>
                    <div class="oe_title mb16">
                        <h2>
                            <i
                                class="fa fa-warehouse text-primary mr8"
                                aria-hidden="true"
                            /> Stock Receipt
                        </h2>
                    </div>

                    <div class="mb16">
                        <div class="o_form_label mb4">
                            <i
                                class="fa fa-barcode text-success mr4"
                                aria-hidden="true"
                            /> Scan or Enter Barcode
                        </div>
                        <field
                            name="barcode_input"
                            placeholder="Scan or enter barcode here..."
                            class="o_input o_field_highlight"
                            style="font-size: 18px;"
                        />
                    </div>

                    <separator string="Products to Receive" class="mt16 mb12" />

                    <field name="line_ids" nolabel="1" class="oe_edit_only">
                        <tree
                            editable="bottom"
                            decoration-info="product_id"
                            decoration-muted="not barcode"
                        >
                            <field name="product_id" />
                            <field name="barcode" />
                            <field name="quantity" />
                            <field name="stock_move_id" />
                        </tree>
                    </field>

                    <separator string="Lots / Serial Numbers" class="mt16 mb12" />

                    <field name="lot_ids" nolabel="1" class="oe_edit_only">
                        <tree editable="bottom">
                            <field name="stock_move_id" />
                            <field name="product_id" />
                            <field name="lot_name" />
                            <field name="expiration_date" />
                        </tree>
                    </field>

                    <footer class="mt16">
                        <button
                            string="Confirm"
                            type="object"
                            name="action_confirm"
                            class="btn-primary"
                            icon="fa-check"
                            confirm="Are you sure you want to confirm this stock receipt?"
                        />
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            icon="fa-times"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
