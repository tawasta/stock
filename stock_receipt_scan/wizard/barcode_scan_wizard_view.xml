<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_barcode_scan_wizard_form" model="ir.ui.view">
        <field name="name">barcode.scan.wizard.form</field>
        <field name="model">barcode.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Product" version="7.0">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <i
                                class="fa fa-barcode text-primary"
                                style="margin-right:8px;"
                                aria-hidden="true"
                            /> Barcode Scan
                        </h2>
                    </div>

                    <div class="mt16 mb8">
                        <div class="o_form_label">
                            <i
                                class="fa fa-truck text-info mr4"
                                aria-hidden="true"
                            /> Picking
                        </div>
                        <field
                            name="picking_id"
                            class="o_input o_field_highlight"
                            readonly="1"
                        />
                    </div>

                    <div class="mt16 mb16">
                        <div class="o_form_label">
                            <i
                                class="fa fa-camera text-success mr4"
                                aria-hidden="true"
                            /> Scan Barcode
                        </div>
                        <field
                            name="barcode"
                            placeholder="Scan barcode here..."
                            class="o_input o_field_highlight"
                            style="font-size: 18px;"
                            options="{'no_quick_create': True}"
                        />
                    </div>

                    <field
                        name="info_message"
                        readonly="1"
                        nolabel="1"
                        invisible="not info_message"
                        class="text-warning fw-bold"
                    />

                    <field name="scanned_barcodes" nolabel="1">
                        <tree>
                            <field name="barcode" />
                            <field name="ai_01" />
                            <field name="ai_10" />
                            <field name="ai_17" />
                        </tree>
                    </field>

                    <separator string="Scanned Products" colspan="2" class="mt16" />

                    <field name="scanned_line_ids" nolabel="1">
                        <tree
                            decoration-info="product_id"
                            decoration-muted="not lot_id"
                        >
                            <field name="product_id" />
                            <field name="lot_name" />
                            <field name="lot_id" />
                            <field name="expiration_date" />
                        </tree>
                    </field>

                    <footer class="mt16">
                    	<button
                            name="action_save_lines"
                            type="object"
                            string="Save Scanned Lines"
                            class="btn-primary"
                        />
                        <button
                            string="Close"
                            icon="fa-times"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
