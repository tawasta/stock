<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_receipt_form" model="ir.ui.view">
        <field name="name">stock.receipt.form</field>
        <field name="model">stock.receipt</field>
        <field name="arch" type="xml">
            <form string="Stock Receipt">
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="create_date" />
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" />
                                    <field name="barcode" />
                                    <field name="quantity" />
                                    <field name="stock_move_id" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>


    <record id="view_stock_receipt_tree" model="ir.ui.view">
        <field name="model">stock.receipt</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <record id="view_stock_receipt_line_tree" model="ir.ui.view">
        <field name="model">stock.receipt.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="receipt_id" />
                <field name="product_id" />
                <field name="barcode" />
                <field name="quantity" />
                <field name="stock_move_id" />
                <field name="stock_picking_id" />
            </tree>
        </field>
    </record>

    <!-- Stock Receipt Line form view -->
    <record id="view_stock_receipt_line_form" model="ir.ui.view">
        <field name="model">stock.receipt.line</field>
        <field name="arch" type="xml">
            <form string="Stock Receipt Line">
                <sheet>
                    <group>
                        <field name="receipt_id" readonly="1" />
                        <field name="product_id" readonly="1" />
                        <field name="barcode" readonly="1" />
                        <field name="quantity" />
                        <field name="stock_move_id" readonly="1" />
                        <field name="stock_picking_id" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_receipt_line" model="ir.actions.act_window">
        <field name="name">Stock Receipt Lines</field>
        <field name="res_model">stock.receipt.line</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_stock_receipt" model="ir.actions.act_window">
        <field name="name">Stock Receipts</field>
        <field name="res_model">stock.receipt</field>
        <field name="view_mode">tree,form</field>
    </record>

