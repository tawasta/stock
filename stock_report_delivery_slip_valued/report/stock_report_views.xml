<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="action_report_delivery_valued" model="ir.actions.report">
    <field name="name">Delivery Slip (with prices)</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >stock_report_delivery_slip_valued.report_deliveryslip_valued</field>
    <field
      name="report_file"
    >stock_report_delivery_slip_valued.report_deliveryslip_valued</field>
    <field
      name="print_report_name"
    >'Delivery Slip (with prices) - %s - %s' % (object.partner_id.name or '', object.name)</field>
    <field name="binding_model_id" ref="stock.model_stock_picking" />
    <field name="binding_type">report</field>
    <!-- Prices are only printed on outgoing deliveries -->
    <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
  </record>
</odoo>
