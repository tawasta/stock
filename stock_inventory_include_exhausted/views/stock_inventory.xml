<odoo>


    <record id="view_inventory_group_form" model="ir.ui.view">
        <field name="model">stock.inventory</field>
        <field name="name">stock.inventory.form.inherit.include.exhausted</field>
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form" />
        <field name="arch" type="xml">
            <field name="exclude_sublocation" position="after">
                <field
                    name="include_exhausted"
                    readonly="state in ['in_progress', 'done']"
                />
            </field>
        </field>
    </record>

</odoo>
